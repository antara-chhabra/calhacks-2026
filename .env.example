# .env at the REPO ROOT (gitignored). This file lists every key with no secret values (PRD §8.11).
# Fill .env with `node scripts/keys.mjs`; verify with `node scripts/keys.mjs --check`.
# --- Runtime
FC_MODE=live                      # live | demo
FC_ENGINE=droid                   # default engine for house fighters: droid | direct | mock
FC_KILL=0
FC_MONEY_MODE=ledger              # ledger | live (live is blocked until Q-011/Q-012, ADR-024)
FC_RUNNER_PORT=8787               # admin API, 127.0.0.1 only
FC_PUBLIC_PORT=8788               # public API, the only tunnelled port
FC_DIRECTOR_TOKEN=                # random 32+ chars (generated by keys.mjs)
FC_PUBLIC_WEB_URL=                # where phones open the web app (QR target)
FC_PUBLIC_RUNNER_URL=             # tunnel URL for FC_PUBLIC_PORT (BYO submitUrl, x402 routes)
# --- SpacetimeDB
FC_STDB_URI=ws://127.0.0.1:3000   # or wss://maincloud.spacetimedb.com
FC_STDB_DB=fightcard
FC_STDB_TOKEN=                    # runner identity token, written by `npm run claim-runner`
VITE_STDB_URI=ws://127.0.0.1:3000
VITE_STDB_DB=fightcard
VITE_PUBLIC_WEB_URL=
VITE_RUNNER_ADMIN_URL=http://127.0.0.1:8787
# --- Match tuning
FC_BET_WINDOW_S=90
FC_INTRO_MS=6000
FC_MATCH_MS=120000
FC_COMMUNITY_SLOTS=1
FC_SEASON=off                     # on | off
FC_SEASON_BET_WINDOW_S=20
FC_KEEP_SANDBOX=0
# --- Factory Droid (models are secret; never commit values). H0 policy: low-cost models only (ADR-023)
FACTORY_API_KEY=
FC_DROID_EXEC=./bin/droid-sandboxed
FC_MODEL_VEX=
FC_MODEL_SAGE=
FC_MODEL_GLITCH=
FC_MODEL_QUILL=
FC_MODEL_BRICK=
FC_MODEL_PIP=
FC_TIER_STANDARD_MODEL=
FC_TIER_PRO_MODEL=
FC_MAX_SESSIONS_PER_HOUR=120
FC_MAX_CREDITS_PER_HOUR=
FC_DEMO_RESERVE=6
# --- Direct fallback (FC-F-046)
FC_DIRECT_BASE_URL=
FC_DIRECT_API_KEY=
FC_DIRECT_MODEL=
# --- Coinbase x402 / CDP (E15) -- deferred, configure later
FC_PAYMENTS=off                   # off | testnet
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
FC_ENTRY_FEE_USD=0.01
FC_HINT_FEE_USD=0.02
FC_PURSE_TOPUP_USDC=0.05
# --- ElevenLabs (E17) -- deferred (ADR-025); H0 uses library SFX
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_VEX=
ELEVENLABS_VOICE_SAGE=
ELEVENLABS_VOICE_GLITCH=
ELEVENLABS_VOICE_QUILL=
ELEVENLABS_VOICE_BRICK=
ELEVENLABS_VOICE_PIP=
ELEVENLABS_VOICE_ANNOUNCER=
# --- Fetch.ai (E16, COULD) -- deferred
FC_BOOKIE_HMAC=                   # random (generated by keys.mjs)
AGENTVERSE_API_KEY=
